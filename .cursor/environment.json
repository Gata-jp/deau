{
  "name": "deau (Next.js + Prisma + PostgreSQL)",
  "install": "bash .cursor/scripts/install.sh",
  "start": "bash .cursor/scripts/start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "bash .cursor/scripts/start.sh && npm run dev",
      "description": "Ensures the local PostgreSQL is up, then runs the Next.js dev server on port 3000."
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
